<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo Sim system plugins of the Autonomous Smart Factory AMR. ImuDecimator: 1 kHz IMU sampling with a 10-sample block-mean output at 100 Hz (DEC-038).</description>
  <maintainer email="nikhiljangid962@gmail.com">Nikhil Jangid</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
