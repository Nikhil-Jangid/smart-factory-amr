<?xml version="1.0" ?>
<!--
  M3 sensor test world (DEC-034, Task B). Used by TEST-M3-04 to -09:
    ros2 launch amr_bringup sim.launch.py headless:=true sensors:=true world:=sensor_test.sdf
  Systems and physics are those of the stock Gazebo Sim 8 empty.sdf (1 ms step = 1 kHz), plus the
  Sensors system (ogre2; required by gpu_lidar) and the IMU system.

  Static targets (boxes 1.0 m high, 0.20 m thick, centred at z 0.5 m so the 0.230 m scan plane hits
  their middle). Distances are from the laser_frame origin to the target face, for the robot spawned at
  the world origin with yaw 0: laser_frame is then at (0.070, 0, 0.230) m (TEST-M3-03).
    target_front_1m  face x =  1.070 m  ->  1.0 m at bearing   0 deg (half-width 26.57 deg)  TEST-M3-05, -06
    target_left_3m   face y =  3.000 m  ->  3.0 m at bearing +90 deg (half-width 14.04 deg)  TEST-M3-05, -06
    target_rear_6m   face x = -5.930 m  ->  6.0 m at bearing 180 deg (half-width  9.46 deg)  TEST-M3-05, -06
    target_right_2m  face y = -2.000 m  ->  2.0 m at bearing -90 deg (half-width 14.04 deg)  TEST-M3-06 (FOV)
    target_low       0.60 x 0.60 x 0.15 m, top 0.15 m (below the scan plane), centre 2.0 m at
                     bearing +45 deg (sector +33.0 to +57.0 deg); nothing behind it in that sector   TEST-M3-06 (D8)
  Every target lies inside x -6.13 .. 1.27 m, y -2.20 .. 3.20 m; nothing is within 0.45 m of the laser.
  Motion tests (TEST-M3-08, -09) spawn the robot in the free area at y = -20 m (ground plane 100 x 100 m).
-->
<sdf version="1.6">
  <world name="sensor_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_front_1m">
      <static>true</static>
      <pose>1.170 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 1.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 1.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="target_left_3m">
      <static>true</static>
      <pose>0.070 3.100 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="target_rear_6m">
      <static>true</static>
      <pose>-6.030 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 2.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="target_right_2m">
      <static>true</static>
      <pose>0.070 -2.100 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="target_low">
      <static>true</static>
      <pose>1.484 1.414 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.15</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
