# M4 odometry visualization (TEST-M4-11): RobotModel, TF and the odometry pose trail
# (/diff_drive_controller/odom, last 1000 poses, kept every 0.05 m or 0.1 rad). Covariance display off: the
# DEC-042 "not measured" variances (1e3 for z, roll, pitch) would draw an ellipsoid covering the view.
# Usage (second terminal, after ros2 launch amr_bringup sim.launch.py):
#   rviz2 -d $(ros2 pkg prefix amr_bringup)/share/amr_bringup/rviz/odometry.rviz --ros-args -p use_sim_time:=true
# Window 860 x 845, narrow enough that the window manager places it beside the Gazebo GUI (1000 px) when RViz is started
# after Gazebo, so neither covers the other in screenshots and recordings (tools/sim_capture.py, tools/sim_record.sh;
# xwd and ximagesrc capture visible pixels only). A requested X/Y position is ignored by the window manager (mutter).
# No Views panel and a view of the whole 1 m square (distance 9, pitch 1.35), so the 3D panel shows the full trail.
# Fixed frame odom; the trail is the odometry estimate, the Gazebo GUI shows the true motion.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 16
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.8
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (/diff_drive_controller/odom)
      Enabled: true
      Topic:
        Value: /diff_drive_controller/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Keep: 1000
      Shape:
        Value: Arrow
        Color: 255; 200; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 9
      Focal Point:
        X: 0.5
        Y: 0
        Z: 0
      Pitch: 1.35
      Yaw: 3.14
Window Geometry:
  Displays:
    collapsed: false
  Height: 845
  Width: 860
  Hide Left Dock: false
  Hide Right Dock: true
