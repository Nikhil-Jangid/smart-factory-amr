# M3 sensor visualization (TEST-M3-10; DEC-035: RobotModel, TF and LaserScan only, no IMU display).
# Usage (second terminal, after `ros2 launch amr_bringup sim.launch.py sensors:=true world:=sensor_test.sdf`):
#   rviz2 -d $(ros2 pkg prefix amr_bringup)/share/amr_bringup/rviz/sensors.rviz --ros-args -p use_sim_time:=true
# Fixed frame odom: with the robot spawned at the world origin, odom coincides with the world, so the scan outlines
# the sensor_test.sdf targets at their world positions (1 m grid): front 1 m, left 3 m, right 2 m, rear 6 m.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 16
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.8
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Alpha: 1
      Decay Time: 0
      Value: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 16
      Focal Point:
        X: -1.5
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: 3.14
