# M6 localization view (TEST-M6-10). Fixed frame map: the robot moves on the saved M5 map.
#   Map          /map from map_server (Transient Local, so it appears even if RViz starts late). The map is fixed:
#                it does not change during localization (unlike M5).
#   LaserScan    /scan, the current scan (red points). Lying on the black walls = the pose estimate is right.
#   Particles    /particle_cloud (nav2_rviz_plugins ParticleCloud, Best Effort): AMCL's pose guesses (green arrows).
#                A wide cloud = uncertain; a tight cloud on the robot = localized.
#   AMCL pose    /amcl_pose with its covariance ellipse (position) and cone (heading).
#   Odometry     /diff_drive_controller/odom trail (yellow), drawn in the map frame through map -> odom.
#   RobotModel, TF (map, odom, base_footprint, laser_frame names shown).
#   Tool "2D Pose Estimate" (key P): click and drag on the map to send /initialpose (a rough start pose).
# Usage (after sim.launch.py sensors:=true world:=mapping_arena.sdf and localization.launch.py):
#   rviz2 -d $(ros2 pkg prefix amr_bringup)/share/amr_bringup/rviz/localization.rviz --ros-args -p use_sim_time:=true
# Window 860 x 845 (beside the Gazebo GUI, as mapping.rviz). Top-down view of the whole 10 x 8 m arena.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
      Offset:
        X: 3
        Y: 0
        Z: 0
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map (/map)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.85
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: Particles (/particle_cloud)
      Enabled: true
      Color: 0; 180; 0
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.3
      Topic:
        Value: /particle_cloud
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose (/amcl_pose)
      Enabled: true
      Shape: Arrow
      Color: 255; 25; 0
      Shaft Length: 0.4
      Shaft Radius: 0.03
      Head Length: 0.15
      Head Radius: 0.08
      Covariance:
        Value: true
        Position:
          Value: true
          Color: 204; 51; 204
          Alpha: 0.3
          Scale: 1
        Orientation:
          Value: true
          Color: 255; 255; 127
          Alpha: 0.5
          Scale: 1
          Frame: Local
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry (/diff_drive_controller/odom)
      Enabled: true
      Topic:
        Value: /diff_drive_controller/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Position Tolerance: 0.1
      Angle Tolerance: 0.2
      Keep: 500
      Shape:
        Value: Arrow
        Color: 255; 200; 0
        Alpha: 1
        Shaft Length: 0.2
        Shaft Radius: 0.015
        Head Length: 0.07
        Head Radius: 0.04
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.8
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        laser_frame:
          Value: true
      Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      X: 3
      Y: 0
      Scale: 60
      Angle: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 845
  Width: 860
  Hide Left Dock: false
  Hide Right Dock: true
