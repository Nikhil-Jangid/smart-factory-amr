digraph G {
node [shape=box];
"base_footprint" [label="base_footprint"];
"base_link" [label="base_link"];
"caster_link" [label="caster_link"];
"left_wheel_link" [label="left_wheel_link"];
"lidar_mount_link" [label="lidar_mount_link"];
"right_wheel_link" [label="right_wheel_link"];
node [shape=ellipse, color=blue, fontcolor=blue];
"base_footprint" -> "base_footprint_joint" [label="xyz: 0 0 0.075 \nrpy: 0 -0 0"]
"base_footprint_joint" -> "base_link"
"base_link" -> "caster_joint" [label="xyz: -0.36 0 -0.05 \nrpy: 0 -0 0"]
"caster_joint" -> "caster_link"
"base_link" -> "left_wheel_joint" [label="xyz: 0 0.2 0 \nrpy: 0 -0 0"]
"left_wheel_joint" -> "left_wheel_link"
"base_link" -> "lidar_mount_joint" [label="xyz: 0.07 0 0.125 \nrpy: 0 -0 0"]
"lidar_mount_joint" -> "lidar_mount_link"
"base_link" -> "right_wheel_joint" [label="xyz: 0 -0.2 0 \nrpy: 0 -0 0"]
"right_wheel_joint" -> "right_wheel_link"
}
