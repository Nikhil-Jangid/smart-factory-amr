<?xml version="1.0"?>
<robot name="probe">
  <link name="root"/>
  <joint name="root_joint" type="fixed"><parent link="root"/><child link="a"/><origin xyz="0 0 0"/></joint>
  <link name="a">
    <inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
  </link>
  <joint name="ab" type="fixed"><parent link="a"/><child link="b"/><origin xyz="1 0 0"/></joint>
  <link name="b">
    <inertial><origin xyz="0 0 0"/><mass value="1.0"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
  </link>
  <joint name="ac" type="continuous"><parent link="a"/><child link="c"/><origin xyz="0 1 0"/><axis xyz="0 1 0"/></joint>
  <link name="c">
    <inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
  </link>
</robot>
