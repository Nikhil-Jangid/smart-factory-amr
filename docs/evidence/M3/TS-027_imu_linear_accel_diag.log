## d11diag.py
import importlib.util, math, os, statistics, sys, threading, time
P='<home>/Projects/smart-factory-amr/docs/evidence/M3/TEST-M3-D_imu_encoder_measure.py'
spec=importlib.util.spec_from_file_location('d',P); d=importlib.util.module_from_spec(spec); spec.loader.exec_module(d)
M2=d.M2
M2.rclpy.init(); rec=d.Recorder(); ex=M2.SingleThreadedExecutor(); ex.add_node(rec)
threading.Thread(target=ex.spin,daemon=True).start(); r=M2.Run(rec)
r.ready()
legs=r.profile([(3.0,0.5,0.0),(3.0,0.0,0.0)])
t0,t1=legs[0][0],legs[0][1]
psi0=r.nearest(rec.gt,t0)[6]
sp=r.body_speed(r.samples(t0-0.5,legs[1][1]),psi0)
print(f'# leg start {t0:.3f}, end {t1:.3f}')
for a,b,lab in ((t0-0.2,t0+1.3,'speed-up'),(t1-0.1,t1+0.8,'braking')):
    print('##',lab,'(t rel start; imu ax 0.05 s mean; gt speed; gt accel from speed over 0.1 s)')
    t=a
    while t<b:
        im=rec.imu_between(t,t+0.05)
        v=[s for s in sp if t<=s[0]<t+0.05]
        ax=statistics.fmean(x[1] for x in im) if im else float('nan')
        vv=statistics.fmean(s[1] for s in v) if v else float('nan')
        print(f'{t-t0:+.2f}  ax {ax:+.4f}  az {statistics.fmean(x[3] for x in im) if im else float("nan"):+.4f}  v {vv:+.4f}  n_imu {len(im)}')
        t+=0.05
allimu=rec.imu_between(t0-1,legs[1][1])
print('# max |ax| over profile', max(abs(x[1]) for x in allimu), 'n', len(allimu))
ex.shutdown(); sys.stdout.flush(); os._exit(0)

