## lagdiag.py
import sys, time, statistics as st
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import QoSProfile, HistoryPolicy, ReliabilityPolicy, qos_profile_sensor_data
from rosgraph_msgs.msg import Clock
from sensor_msgs.msg import LaserScan, Imu
def sec(s): return s.sec + s.nanosec*1e-9
class N(Node):
    def __init__(s):
        super().__init__('lagdiag', parameter_overrides=[Parameter('use_sim_time', Parameter.Type.BOOL, True)])
        s.clock=None; s.rel=[]; s.be=[]; s.imu=[]; s.wall=[]
        s.create_subscription(Clock,'/clock',lambda m: setattr(s,'clock',sec(m.clock)),10)
        s.create_subscription(LaserScan,'/scan',lambda m: s.rel.append((sec(m.header.stamp), s.clock, time.monotonic())),QoSProfile(history=HistoryPolicy.KEEP_LAST,depth=200,reliability=ReliabilityPolicy.RELIABLE))
        s.create_subscription(LaserScan,'/scan',lambda m: s.be.append((sec(m.header.stamp), s.clock)),qos_profile_sensor_data)
        s.create_subscription(Imu,'/imu',lambda m: s.imu.append((sec(m.header.stamp), s.clock)),qos_profile_sensor_data)
rclpy.init(); n=N(); t=time.monotonic()
while time.monotonic()-t<70: rclpy.spin_once(n,timeout_sec=0.05)
for name,d in (('scan reliable',n.rel),('scan best-effort',n.be),('imu',n.imu)):
    d=[x for x in d if x[0]>=8.0]
    l=[c-s for s,c,*_ in d if c is not None]
    l2=sorted(l)
    print(f'{name}: n={len(l)} mean {st.mean(l):+.4f} min {l2[0]:+.4f} p50 {l2[len(l)//2]:+.4f} p95 {l2[int(.95*len(l))]:+.4f} max {l2[-1]:+.4f}')
    if name.startswith('scan'):
        big=[(round(s,3),round(c-s,4)) for s,c,*_ in d if c is not None and abs(c-s)>0.05]
        print('  >0.05:', big[:15])
        im=[(round(s,3),round(c-s,4)) for s,c in n.imu if c is not None and s>=8.0 and abs(c-s)>0.02]
        print('  imu |lag|>0.02 :', im[:15])
        gaps=[(round(a[0],2),round(b[0]-a[0],3)) for a,b in zip(d,d[1:]) if abs(b[0]-a[0]-0.1)>0.001]
        print('  scan stamp gaps != 0.1:', gaps[:10])
        if name=='scan reliable':
            w=[(round(s,2),round(b[2]-a[2],3)) for a,b in zip(d,d[1:]) for s in [b[0]] if b[2]-a[2]>0.15]
            print('  wall receipt gaps >0.15 s:', w[:10])
