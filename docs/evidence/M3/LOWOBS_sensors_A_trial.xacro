<?xml version="1.0"?>
<!--
  M3 FEASIBILITY-GATE PROTOTYPE (throwaway; not the M3 implementation). DEC-030 to DEC-034 values.
  laser_frame and imu_link have no <inertial>: fixed-joint children are lumped into their parent
  by SDFormat, so the total mass stays 9.4 kg (DEC-034). The gate checks that the sensor poses survive.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <joint name="laser_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.12413936106985</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:macro name="imu_noise" params="sd">
    <noise type="gaussian"><mean>0.0</mean><stddev>${sd}</stddev></noise>
  </xacro:macro>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><xacro:imu_noise sd="0.001"/></x>
          <y><xacro:imu_noise sd="0.001"/></y>
          <z><xacro:imu_noise sd="0.001"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_noise sd="0.01"/></x>
          <y><xacro:imu_noise sd="0.01"/></y>
          <z><xacro:imu_noise sd="0.01"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- LOWOBS option 3 TRIAL (scratch only; values are investigation assumptions, not decisions):
       forward depth camera at the chassis front edge, 0.190 m high, pitched 25 deg down. -->
  <joint name="depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_link"/>
    <origin xyz="0.135 0 0.115" rpy="0 0.4363323129985824 0"/>
  </joint>
  <link name="depth_link"/>
  <gazebo reference="depth_link">
    <sensor name="depth" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/depth</topic>
      <gz_frame_id>depth_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184364492350666</horizontal_fov>
        <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
        <clip><near>0.10</near><far>4.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
